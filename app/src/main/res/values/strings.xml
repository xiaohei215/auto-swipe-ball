    <!-- 主界面 -->
    <string name="title_main">自动上滑助手</string>
    <string name="subtitle_main">悬浮球控制 · 按周期在屏幕中部执行一次上滑，不模拟点击</string>
    <string name="group_permission">权限准备</string>
    <string name="group_control">运行控制</string>
    <string name="row_overlay">悬浮窗权限</string>
    <string name="row_accessibility">无障碍服务</string>
    <string name="row_battery">电池优化白名单</string>
    <string name="btn_grant">去开启</string>
    <string name="btn_autostart">自启动 / 后台白名单</string>
    <string name="btn_start_ball">启动悬浮球</string>
    <string name="btn_stop_ball">停止悬浮球</string>
    <string name="btn_settings">参数设置</string>
    <string name="label_note">使用说明</string>
    <string name="note_text">1. 依次开启上方三项权限；iQOO / vivo（OriginOS）请额外进入「自启动 / 后台高耗电」白名单，避免服务被清理。\n2. 点击「启动悬浮球」，悬浮球默认出现在屏幕右侧偏上位置，可长按拖动。\n3. 单击悬浮球开始运行（绿色，显示倒计时环）；再次单击暂停（琥珀色）。\n4. 双击悬浮球退出；也可在通知栏点「退出」。\n5. 无障碍被关闭或悬浮窗权限被回收时，悬浮球变红并提示原因，处理后单击悬浮球即可恢复。\n6. 本插件仅注入上滑手势，不读取屏幕内容、不模拟点击、不依赖 Root。</string>

